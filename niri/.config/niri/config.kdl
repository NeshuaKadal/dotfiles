// Imports
include "noctaliaRules.kdl"
include "keybinds.kdl"
include "rules.kdl"

// Startup
spawn-at-startup "mpd"
spawn-at-startup "zen-browser"
spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
spawn-sh-at-startup "noctalia"

// Preferences
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
hotkey-overlay {
    skip-at-startup
    hide-not-bound
}
clipboard {
    disable-primary
}
animations {
    slowdown 0.8
}
overview {
    workspace-shadow {
	on
    }
}
blur {
    off
    passes 3
    offset  3.0
    noise 0.03
    saturation 1.0 //1.6
}

// Layout
layout {
    gaps 8
    center-focused-column "on-overflow"
    always-center-single-column
    default-column-display "tabbed"
    //background-color "transparent"

    default-column-width { proportion 0.33334; }

    focus-ring {
	off
    }

    border {
	width 2
    }

    shadow {
	on
    }

    tab-indicator {
	position "left"
	gap 2
	gaps-between-tabs 8
	length total-proportion=1.0
	hide-when-single-tab
    }
}

// Input
input {
    keyboard {
	repeat-delay 200
	repeat-rate 35
	numlock
	xkb {
	    layout "us"
	}
    }
    mouse {
	accel-speed -0.5
	accel-profile "flat"
    }
    focus-follows-mouse max-scroll-amount="50%"
}

// Output
output "DP-2" {
    mode "3440x1440@143.923"
    scale 1
    transform "normal"
    position x=0 y=0
    focus-at-startup
    hot-corners {
	off
    }
}

// Noctalia
include "noctalia.kdl"
